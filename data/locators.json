{
  "_comment": "Locators: where in the app's code a question to the owner is about, found by the names in it and never judged (backlog 0487, ADR-022). A locator makes no finding and credits nothing; crates/sv-check/src/locate.rs says why, and data/README.md lists the fields.",
  "locators": [
    {
      "id": "locate.authorization-checks",
      "questions": [
        "V8.1.1",
        "V8.3.1"
      ],
      "finds": "functions whose names say they check a role or a permission, where they are written and where they are used",
      "names": "^(authori[sz]\\w*|(require|ensure|verify|assert|check|enforce|must)(role|roles|permission|permissions|perm|perms|admin|owner|ownership|scope|scopes|access|policy|ability|abilities|staff|superuser)\\w*|has(role|roles|permission|permissions|perm|perms|scope|scopes|access|ability|anyrole|anyauthority|authority)\\w*|can(access|edit|view|delete|update|read|write|manage|create|modify)\\w*|is(admin|owner|authori[sz]ed|allowed|staff|superuser|permitted)|(permission|permissions|roles?|admin|owner|staff|superuser)required|userpassestest|preauthori[sz]e|rolesallowed)$",
      "queries": {
        "python": "[(function_definition name: (identifier) @defined)\n (call function: (identifier) @used)\n (call function: (attribute attribute: (identifier) @used))\n (decorator (identifier) @used)\n (decorator (attribute attribute: (identifier) @used))\n (argument_list (identifier) @used)]",
        "javascript": "[(function_declaration name: (identifier) @defined)\n (method_definition name: (property_identifier) @defined)\n (variable_declarator name: (identifier) @defined value: [(arrow_function) (function_expression)])\n (call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))\n (arguments (identifier) @used)]",
        "typescript": "[(function_declaration name: (identifier) @defined)\n (method_definition name: (property_identifier) @defined)\n (variable_declarator name: (identifier) @defined value: [(arrow_function) (function_expression)])\n (call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))\n (arguments (identifier) @used)]"
      }
    },
    {
      "id": "locate.owner-checks",
      "questions": [
        "V8.1.1",
        "V8.3.1"
      ],
      "finds": "comparisons and queries of a record's owner or user id, where the app may keep a person to their own records",
      "names": "(owner|ownerid|userid|authorid|createdby|accountid)['\"\\]\\)]*\\s*(=|!=|<>|:)|(==|!=)=?\\s*[\\w.\\[\\]'\"()]*(owner|ownerid|userid|authorid|createdby|accountid)\\b",
      "queries": {
        "python": "[(comparison_operator) @used\n (string) @used\n ((call function: (attribute attribute: (identifier) @method) arguments: (argument_list (keyword_argument) @used))\n  (#match? @method \"^(filter_by|filter|get_or_404|first_or_404|where|get)$\"))]",
        "javascript": "[(binary_expression operator: [\"===\" \"!==\" \"==\" \"!=\"]) @used\n (string) @used\n (template_string) @used\n ((pair key: (property_identifier) @key) @used\n  (#match? @key \"^(owner|ownerId|owner_id|userId|user_id|authorId|author_id|createdBy|created_by|accountId|account_id)$\"))]",
        "typescript": "[(binary_expression operator: [\"===\" \"!==\" \"==\" \"!=\"]) @used\n (string) @used\n (template_string) @used\n ((pair key: (property_identifier) @key) @used\n  (#match? @key \"^(owner|ownerId|owner_id|userId|user_id|authorId|author_id|createdBy|created_by|accountId|account_id)$\"))]"
      }
    },
    {
      "id": "locate.refusals",
      "questions": [
        "V8.1.1",
        "V8.3.1"
      ],
      "finds": "places that refuse a request with a 403 (Forbidden), whether the answer is sent, returned, or raised",
      "names": "^(403|forbidden|httpforbidden|permissiondenied|forbiddenerror|forbiddenexception)$",
      "unless": "(csrf|xsrf|forged|forgery|antiforgery|token|password|passwd|passphrase|comparedigest|checkpw)",
      "queries": {
        "python": "[(argument_list (integer) @used)\n (argument_list (keyword_argument value: (integer) @used))\n (return_statement (expression_list (integer) @used))\n (raise_statement (identifier) @used)\n (raise_statement (call function: (identifier) @used))\n (raise_statement (call function: (attribute attribute: (identifier) @used)))]",
        "javascript": "[(arguments (number) @used)\n (throw_statement (new_expression constructor: (identifier) @used))\n ((assignment_expression left: (member_expression property: (property_identifier) @field) right: (number) @used)\n  (#match? @field \"^(status|statusCode)$\"))]",
        "typescript": "[(arguments (number) @used)\n (throw_statement (new_expression constructor: (identifier) @used))\n ((assignment_expression left: (member_expression property: (property_identifier) @field) right: (number) @used)\n  (#match? @field \"^(status|statusCode)$\"))]"
      }
    },
    {
      "id": "locate.decoding",
      "questions": [
        "V1.1.1"
      ],
      "finds": "calls that turn coded text back into plain text: web-address decoding, base64, and HTML unescaping",
      "names": "^(unquote|unquoteplus|unquotetobytes|unescape|htmlunescape|b64decode|urlsafeb64decode|standardb64decode|b32decode|b16decode|a85decode|b85decode|decodebytes|decodeuricomponent|decodeuri|atob)$",
      "queries": {
        "python": "[(call function: (identifier) @used)\n (call function: (attribute attribute: (identifier) @used))]",
        "javascript": "[(call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))]",
        "typescript": "[(call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))]"
      }
    },
    {
      "id": "locate.dangerous-places",
      "questions": [
        "V1.3.3"
      ],
      "finds": "places the app hands a value to another program or format: a shell command, a database query, a file sent back, an email, or a spreadsheet row",
      "names": "^exec$|(^|\\.)(system|popen|checkoutput|checkcall|execsync|execfile|execfilesync|spawn|spawnsync|execute|executemany|executescript|queryrawunsafe|executerawunsafe|sendfile|sendfromdirectory|fileresponse|download|sendmail|writerow|writerows|tocsv|toexcel)$|subprocess\\.(run|call)\\b|childprocess\\.exec\\b|(db|pool|client|conn|connection|sequelize|knex)\\.(query|raw)\\b",
      "queries": {
        "python": "[(call function: (identifier) @used)\n (call function: (attribute) @used)]",
        "javascript": "[(call_expression function: (identifier) @used)\n (call_expression function: (member_expression) @used)]",
        "typescript": "[(call_expression function: (identifier) @used)\n (call_expression function: (member_expression) @used)]"
      }
    },
    {
      "id": "locate.heavy-work",
      "questions": [
        "V15.1.3",
        "V15.2.2"
      ],
      "finds": "work that can be slow or heavy: password hashing, images and PDFs, archives, exports, calls to an AI model, and files uploaded",
      "names": "(^|\\.)(hashpw|generatepasswordhash|makepassword|hashsync|pbkdf2hmac|pbkdf2sync|scryptsync|thumbnail|writepdf|makearchive|zipfile|tocsv|toexcel|writerows|generatecontent)$|^(sharp|multer)$|\\bimage\\.open\\b|\\bpdfkit\\.from|\\b(completions|messages|responses)\\.create\\b|\\brequest\\.files\\b|\\breq\\.files?\\b|\\bupload\\.(single|array|fields|any)\\b",
      "queries": {
        "python": "[(call function: [(identifier) (attribute)] @used)\n (attribute) @used]",
        "javascript": "[(call_expression function: [(identifier) (member_expression)] @used)\n (member_expression) @used]",
        "typescript": "[(call_expression function: [(identifier) (member_expression)] @used)\n (member_expression) @used]"
      }
    },
    {
      "id": "locate.availability-brakes",
      "questions": [
        "V15.2.2",
        "V15.1.3"
      ],
      "finds": "the brakes the code shows: timeouts, limits on size, rate, or rows, and work handed to a queue",
      "names": "^(timeout|readtimeout|connecttimeout|limit|limits|maxcontentlength|datauploadmaxmemorysize|fileuploadmaxmemorysize|datauploadmaxnumberfields|maxfilesize|filesize|maxfiles|ratelimit|limiter|slowdown|throttle|throttleclasses|defaultthrottleclasses|defaultthrottlerates|applyasync|enqueue|sharedtask)$|^['\"](maxcontentlength|datauploadmaxmemorysize|fileuploadmaxmemorysize|defaultthrottlerates)['\"]$",
      "queries": {
        "python": "[(keyword_argument name: (identifier) @used)\n (call function: (identifier) @used)\n (call function: (attribute attribute: (identifier) @used))\n (decorator (identifier) @used)\n (assignment left: (identifier) @used)\n (string) @used]",
        "javascript": "[(pair key: (property_identifier) @used)\n (call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))]",
        "typescript": "[(pair key: (property_identifier) @used)\n (call_expression function: (identifier) @used)\n (call_expression function: (member_expression property: (property_identifier) @used))]"
      }
    }
  ],
  "packages": [
    {
      "id": "locate.web-server",
      "questions": [
        "V4.2.1"
      ],
      "finds": "the web server package inside the app, which reads each request after whatever is in front of the app has passed it on",
      "says": "A known flaw in this version, request smuggling among them, is listed as something to fix when the advisory data has been downloaded and StackVet is run with --advisories; the machines in front of the app are not in the list of packages, and nothing here says what they run.",
      "names": {
        "Python": [
          "gunicorn",
          "uvicorn",
          "hypercorn",
          "waitress",
          "daphne",
          "granian"
        ],
        "Ruby": [
          "puma",
          "unicorn",
          "thin",
          "passenger",
          "falcon",
          "webrick"
        ]
      }
    }
  ]
}
