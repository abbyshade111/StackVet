      "finds": "work that can be slow or heavy: password hashing, images and PDFs, archives, exports, calls to an AI model, and files uploaded",
      "names": "(^|\\.)(hashpw|generatepasswordhash|makepassword|hashsync|pbkdf2hmac|pbkdf2sync|scryptsync|thumbnail|writepdf|makearchive|zipfile|tocsv|toexcel|writerows|generatecontent)$|^(sharp|multer)$|\\bimage\\.open\\b|\\bpdfkit\\.from|\\b(completions|messages|responses)\\.create\\b|\\brequest\\.files\\b|\\breq\\.files?\\b|\\bupload\\.(single|array|fields|any)\\b",
      "queries": {
